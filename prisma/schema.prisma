generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inspection {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  propertyType     String   // residential | commercial
  status           String   @default("new")
  // new → pending_approval → estimate_sent → accepted | declined

  // Inspector MacTor — Inspection context
  serviceType        String   @default("repair")  // repair | renovation | new_project
  problemDescription String?   // client's free-text description
  issueCategory      String?   // plumbing | electrical | structural | hvac | roofing | water_damage | pests | doors_windows | exterior | other
  followUpAnswers    Json?     // [{ question, answer }]

  // Client info
  clientName       String?
  clientEmail      String?
  clientPhone      String?
  clientLanguage   String   @default("en")  // en | es | zh | hi | tl
  address          String?
  exifCoords       Json?

  // Photos (Cloudinary URLs)
  photos           Json     @default("[]")

  // AI Analysis
  aiAnalysis       Json?    // Claude Vision full analysis per photo
  aiSummary        Json?    // Aggregated summary

  // Pricing
  aiEstimate       Json?    // AI-generated estimate
  approvedEstimate Json?    // Julio's approved estimate
  approvalNotes    String?  // Julio's notes for AI training

  // Tokens
  approvalToken    String   @unique @default(uuid())
  acceptToken      String   @unique @default(uuid())

  // Timestamps
  approvedAt       DateTime?
  estimateSentAt   DateTime?
  acceptedAt       DateTime?

  trainingData     TrainingData[]
}

model Invoice {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoiceNumber String    @unique  // INV0200, INV0201 ...
  nickname      String?   // internal-only label to tell similar documents apart, never shown to the client
  type          String    @default("invoice")   // invoice | estimate
  status        String    @default("draft")     // draft | sent | paid | overdue

  // Client
  clientName    String
  companyName   String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?

  // Line items: [{description, rate, qty, amount, notes}]
  lineItems     Json      @default("[]")

  // Totals
  subtotal      Float     @default(0)
  discount      Float     @default(0)   // flat $ amount off, applied before HST
  hstEnabled    Boolean   @default(true)
  hst           Float     @default(0)
  total         Float     @default(0)

  // Content
  notes         String?
  photos        Json      @default("[]")  // Cloudinary URLs

  // Dates
  invoiceDate   DateTime  @default(now())
  dueDate       String    @default("On Receipt")
  sentAt        DateTime?
  paidAt        DateTime?
  scheduledDate DateTime? // when the work is planned to happen
  agendaDone    Boolean   @default(false) // checked off in the Agenda, separate from status

  // Link to inspector (optional)
  inspectionId  String?

  sendLogs      SendLog[]
}

// One row per successful email/SMS send — powers the "sent" indicator and
// history (who it went to, when) on the invoice/estimate detail page.
model SendLog {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel   String   // email | sms
  kind      String   // send | remind
  recipient String   // email address or phone number
  sentAt    DateTime @default(now())
}

model InvoiceCounter {
  id              Int @id @default(autoincrement())
  lastInvoiceNum  Int @default(199)
  lastEstimateNum Int @default(199)
  lastTaskNum     Int @default(0)
}

model User {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  username     String   @unique
  passwordHash String
  name         String?
}

model Client {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  name           String    @unique
  email          String?
  phone          String?
  address        String?
  notes          String?

  invoiceCount   Int       @default(0)
  estimateCount  Int       @default(0)
  totalInvoiced  Float     @default(0)
  totalPaid      Float     @default(0)
  lastActivity   DateTime?

  history        Json      @default("[]") // [{date, type, number, total, status}]
}

model ServiceCatalog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  name         String   @unique   // "Masonry Cleaning & Sealing"
  category     String?            // "Masonry" | "Drainage" | "Landscaping" | ...
  description  String?            // most recent scope description
  unit         String?            // "lump sum" | "lf" | "sqft" | ...

  lastPrice    Float
  minPrice     Float
  maxPrice     Float
  avgPrice     Float
  useCount     Int      @default(1)

  priceHistory Json     @default("[]") // [{date,price,estimateNumber,clientName}]
}

model TrainingData {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())

  inspectionId     String
  inspection       Inspection @relation(fields: [inspectionId], references: [id])

  propertyType     String
  damageType       String
  aiPriceSuggested Float
  julioApprovedPrice Float
  julioNote        String?
}

// ── Asistente personal "Mac" (WhatsApp) ─────────────────────────

// An action the assistant wants to take that has an effect outside the
// conversation (send an email, text a client, create a task…). The agent can
// only *propose* it; code executes it after Julio replies "sí" on WhatsApp.
model AssistantAction {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shortCode  Int       @default(autoincrement()) // "#12" in the WhatsApp prompt
  kind       String    // send_email | payment_reminder | job_reminder | send_document | create_task | reply_social …
  summary    String    // human-readable, exactly what Julio confirms
  payload    Json
  status     String    @default("pending") // pending | executed | failed | cancelled | expired
  sessionId  String?
  executedAt DateTime?
  result     Json?
}

// OAuth connection to one external account (Gmail, Zoho, Meta).
// Refresh tokens are AES-256-GCM encrypted with ASSISTANT_ENC_KEY.
model AssistantConnection {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  provider        String    // gmail | zoho | meta
  account         String    // email address or page id
  label           String?   // "gmail_logos", "gmail_mactor", "zoho" …
  encRefreshToken String
  meta            Json      @default("{}") // e.g. Zoho accountId, Meta page list
  scopes          String?
  status          String    @default("active") // active | error
  lastError       String?
  lastSyncAt      DateTime?

  @@unique([provider, account])
}

// Audit log: every inbound/outbound WhatsApp message and every alert,
// also used to dedupe alerts (externalId = Gmail/Zoho/Meta message id).
model AssistantEvent {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  direction  String   // in | out | alert | system
  channel    String   @default("whatsapp")
  text       String
  sessionId  String?
  externalId String?  @unique
  meta       Json?
}

// Singleton (id = 1): current session + WhatsApp 24h window tracking.
model AssistantState {
  id               Int       @id @default(1)
  updatedAt        DateTime  @updatedAt
  currentSessionId String?
  sessionDay       String?   // YYYY-MM-DD (America/Toronto) the session belongs to
  lastInboundAt    DateTime? // last message from Julio → free-form replies allowed for 24h
  paused           Boolean   @default(false)
}
